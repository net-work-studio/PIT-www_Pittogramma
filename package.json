{
  "name": "pittogramma-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "test \"$VERCEL_ENV\" != production || bun run sanity:migrate-cta-images",
    "build": "next build --webpack",
    "check": "ultracite check",
    "cleanup": "rm -rf node_modules .next",
    "predev": "bun run typegen",
    "dev": "next dev",
    "fix": "ultracite fix",
    "newsletter:export-preview": "bun run scripts/export-newsletter-preview.ts",
    "newsletter:validate-map": "bun run scripts/validate-substack-url-map.ts",
    "sanity:backup": "bun run scripts/export-sanity-backup.ts",
    "sanity:migrate-cta-images": "bun run scripts/migrate-cta-images.ts",
    "seo:check-sitemap": "bun run scripts/check-sitemap.ts",
    "start": "next start",
    "typecheck": "node_modules/typescript-7/bin/tsc --noEmit",
    "typegen": "rm -f ./src/sanity/extract.json && bunx sanity schema extract --enforce-required-fields --path ./src/sanity/extract.json && bunx sanity typegen generate"
  },
  "overrides": {
    "@sanity/client": "7.26.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@sanity/client": "7.26.2",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.22",
    "@sanity/vision": "^6.10.1",
    "@teispace/next-themes": "^3.0.0",
    "baseline-browser-mapping": "^2.11.15",
    "caniuse-lite": "^1.0.30001809",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-sanity": "13.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "sanity": "^6.10.1",
    "sanity-plugin-media": "^6.1.6",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@sanity/blueprints": "^0.23.6",
    "@sanity/cli": "8.2.1",
    "@sanity/functions": "^1.6.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.0",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  }
}
